2m \u001b[39m  \u001b[38;5;188m\u2502\u001b[39m\u001b[K\r\n\u001b[38;5;188m\u2502\u001b[39m \u001b[38;5;102m \u001b[39m \u001b[38;5;145mGPT-5.6-Terra\u001b[39m                                                     \u001b[38;5;102m \u001b[39m  \u001b[38;5;188m\u2502\u001b[39m\u001b[K\r\n\u001b[38;5;188m\u2502\u001b[39m \u001b[38;5;102m \u001b[39m \u001b[38;5;145mGPT-5.6-Luna\u001b[39m                                                      \u001b[38;5;102m \u001b[39m  \u001b[38;5;188m\u2502\u001b[39m\u001b[K\r\n\u001b[38;5;188m\u2502\u001b[39m \u001b[38;5;102m \u001b[39m \u001b[38;5;145mGPT-5.5\u001b[39m                                                           \u001b[38;5;102m \u001b[39m  \u001b[38;5;188m\u2502\u001b[39m\u001b[K\r\n\u001b[38;5;188m\u2502\u001b[39m                                                                        \u001b[38;5;188m\u2502\u001b[39m\u001b[K\r\n\u001b[38;5;188m\u2502\u001b[39m \u001b[38;5;145mIntelligence  Low \u25cf\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Ultra  Low\u001b[39m                  \u001b[38;5;188m\u2502\u001b[39m\u001b[K\r\n\u001b[38;5;188m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[38;5;59m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500